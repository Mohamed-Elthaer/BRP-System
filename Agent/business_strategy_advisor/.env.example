# BRP Strategic Intelligence configuration

# Service
STRATEGY_HOST=127.0.0.1
STRATEGY_PORT=8011
STRATEGY_API_KEY=
STRATEGY_REQUIRE_AUTH=false
STRATEGY_DATA_DIR=./data
STRATEGY_DATABASE_URL=

# LLM (Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60

# Business Intelligence adapter
BI_PROVIDER=mock
BI_BASE_URL=
BI_TIMEOUT_SECONDS=15

# Research providers
TAVILY_API_KEY=
TAVILY_MCP_URL=
BRAVE_API_KEY=
GOOGLE_PLACES_API_KEY=
ALLOW_LIVE_PROVIDERS=false

# Budgets
MAX_RESEARCH_QUERIES=5
MAX_EXTRACTED_PAGES=8
MAX_MCP_CALLS=20
MAX_RESPONSE_BYTES=250000
MAX_RESEARCH_SECONDS=45
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_CACHE_ENABLED=true

# Limits
MAX_PLAN_ACTIONS=40
MAX_REVISION_LOOPS=2