# Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rest-ERP?appName=Cluster-ERP

# Groq Cloud AI Keys (LLM Inference)
GROQ_API_KEY=your_groq_api_key_here
ARIA_GROQ_API_KEY=your_secondary_groq_key_here

# AI Models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=llama-3.3-70b-versatile

# Python Agent Service Security & Port
AGENT_SECRET=your_agent_shared_secret_here
AGENT_HOST=127.0.0.1
AGENT_PORT=8005
