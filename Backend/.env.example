# Database (MongoDB Cloud Atlas URI for Sync)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rest-ERP

# Security
SECRET_KEY=your_jwt_secret_key_here
PORT=5000

# Cloudinary (Receipt & Image Storage)
Cloud_name=your_cloudinary_name
API_key=your_cloudinary_api_key
API_secret=your_cloudinary_api_secret

# URLs
CLIENT_URL=http://localhost:5173
AGENT_URL=http://localhost:8000
AGENT_SECRET=your_agent_secret_here

# Groq Cloud AI (Optional - for AI Copilot)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
